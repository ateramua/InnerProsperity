# Plaid (required for Linked Banks)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Set to false to hide/disable Plaid features without removing keys
PLAID_ENABLED=true

# --- Production OAuth (Link / update mode) ---
# 1) Plaid Dashboard → Team settings → Allowed redirect URIs: add your HTTPS callback exactly.
# 2) Host oauth-callback.html (e.g. IntentFlow is public/plaid-oauth-redirect/oauth-callback.html → /plaid-oauth-redirect/oauth-callback.html).
# 3) Set matching URI here and in packaged plaid.env.json. redirect_uri is sent only when PLAID_ENV=production.
# PLAID_ENV=production
# PLAID_REDIRECT_URI=https://your-project.vercel.app/plaid-oauth-redirect/oauth-callback.html

# --- Webhook relay (desktop polls; cannot host webhooks) ---
# Deploy: npm run plaid:relay (JWT verification) or npm run plaid:relay-example (local stub)
# Full steps: docs/plaid-production-deploy.md
# PLAID_WEBHOOK_RELAY_URL=https://your-relay.example
# PLAID_WEBHOOK_RELAY_API_KEY=shared-secret-must-match-relay-RELAY_API_KEY

# --- Relay server env (set on the hosting provider, not necessarily in this file) ---
# PLAID_CLIENT_ID=        # same credentials as app (use production secret when PLAID_ENV=production)
# PLAID_SECRET=
# PLAID_ENV=production
# PORT=8787
# HOST=0.0.0.0
# RELAY_API_KEY=           # optional Bearer for GET /pending — same value as PLAID_WEBHOOK_RELAY_API_KEY in app
# PLAID_RELAY_SKIP_JWT_VERIFY=true   # ONLY for non-Plaid traffic; never in production

# --- Packaged Electron builds ---
# Copy plaid.env.example.json → userData plaid.env.json before first Plaid use (see docs).
# macOS: ~/Library/Application Support/IntentFlow/plaid.env.json
