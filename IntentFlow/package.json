{
  "name": "intentflow",
  "version": "1.0.0",
  "description": "IntentFlow — personal finance and zero-based budgeting",
  "main": "src/main/index.cjs",
  "type": "commonjs",
  "scripts": {
    "clean": "rimraf .next out release dist build",
    "clean:deep": "rimraf .next out release dist build node_modules/.cache .eslintcache",
    "build": "next build && node scripts/copy-export-assets.cjs && node scripts/verify-production-export.cjs",
    "seed:db": "node src/db/scripts/seed-database.js",
    "dist": "npm run clean && npm run build && electron-builder",
    "dist:install-mac": "bash scripts/mac-reinstall-to-applications.sh",
    "start": "cross-env NODE_ENV=production electron .",
    "dev": "node scripts/electron-dev.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.intentflow.moneymanager",
    "productName": "IntentFlow",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "src/db/db-config.cjs",
      "src/db/database.config.js"
    ],
    "files": [
      ".next/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "src/db/**/*",
      "src/views/**/*",
      "src/services/**/*",
      "node_modules/**/*",
      "package.json",
      "next.config.js"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/db/data/",
        "to": "db/data/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.finance",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.3.1",
    "electron-context-menu": "^4.0.0",
    "electron-log": "^5.2.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^9.0.0",
    "electron-updater": "^6.3.9",
    "next": "^14.2.35",
    "plaid": "^41.4.0",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.6",
    "recharts": "^3.8.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "uuid": "^9.0.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "cssnano": "^7.1.3",
    "electron": "^28.3.0",
    "electron-builder": "^26.8.1",
    "mini-css-extract-plugin": "^2.10.1",
    "postcss": "^8.5.8",
    "postcss-discard-comments": "^7.0.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19",
    "terser-webpack-plugin": "^5.3.11",
    "wait-on": "^9.0.4"
  }
}
