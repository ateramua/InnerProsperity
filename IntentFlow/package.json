{
  "name": "intentflow",
  "version": "1.0.0",
  "description": "IntentFlow — personal finance and zero-based budgeting",
  "main": "src/main/index.cjs",
  "type": "commonjs",
  "scripts": {
    "clean": "rimraf .next out release dist build",
    "clean:deep": "rimraf .next out release dist build node_modules/.cache .eslintcache",
    "build": "npm run check:db-architecture && next build && node scripts/copy-export-assets.cjs && node scripts/verify-production-export.cjs && node scripts/verify-testable-dialogs.cjs",
    "generate:empty-schema": "node scripts/generate-empty-schema.cjs",
    "seed:db": "node src/db/scripts/seed-database.js",
    "verify:release-db-policy": "node scripts/verify-release-db-policy.cjs",
    "dist": "npm run clean && npm run generate:empty-schema && npm run seed:db && npm run verify:release-db-policy && npm run build && electron-builder && node scripts/verify-release-artifact-db-policy.cjs",
    "dist:install-mac": "bash scripts/mac-reinstall-to-applications.sh",
    "start": "cross-env NODE_ENV=production electron .",
    "dev": "node scripts/electron-dev.cjs",
    "dev:restart": "node scripts/restart-electron-dev.cjs",
    "ext:dev": "npm run dev --prefix extension",
    "ext:build": "npm run build --prefix extension",
    "ext:build:firefox": "npm run build:firefox --prefix extension",
    "ext:zip": "npm run zip --prefix extension",
    "ext:test": "npm run test --prefix extension",
    "ext:typecheck": "npm run typecheck --prefix extension",
    "ext:native-host:install": "node scripts/install-extension-native-host.cjs",
    "test:plaid": "node scripts/test-plaid-service.cjs",
    "test:sidebar": "node scripts/test-sidebar-account-utils.cjs",
    "test:account-type": "node scripts/test-account-type-utils.cjs",
    "test:account-merge": "node scripts/test-account-merge.cjs",
    "test:monthly-budget": "node scripts/test-monthly-budget-service.cjs",
    "reconcile:budget": "node scripts/reconcile-budget.cjs",
    "ensure:cc-categories": "node scripts/ensure-cc-payment-categories.cjs",
    "test:cc-payment-categories": "node scripts/test-credit-card-payment-category-service.cjs",
    "test:underfunded": "node scripts/test-underfunded-engine.cjs",
    "test:ready-to-assign": "node scripts/test-ready-to-assign-engine.cjs",
    "test:cash-forecast": "node scripts/test-cash-forecast-engine.mjs",
    "test:transaction-import": "node scripts/test-transaction-import-banks.cjs",
    "test:category-ml": "node scripts/test-category-ml.cjs",
    "test:transaction-categorization": "node scripts/test-transaction-categorization.cjs && node scripts/test-transfer-pairing.cjs && node scripts/test-category-ml.cjs",
    "test:account-balance": "node scripts/test-account-balance-engine.cjs",
    "check:db-single-writer": "node scripts/check-db-single-writer.cjs",
    "check:ipc-write-broker": "node scripts/check-ipc-write-broker.cjs",
    "test:db-broker": "node scripts/test-db-broker.cjs",
    "check:db-architecture": "npm run check:db-single-writer && npm run check:ipc-write-broker && npm run test:db-broker",
    "check:db-isolation": "node scripts/test-db-environment-isolation.cjs && npm run generate:empty-schema && npm run seed:db && npm run verify:release-db-policy",
    "plaid:relay": "node scripts/plaid-webhook-relay.cjs",
    "plaid:relay-example": "node scripts/plaid-webhook-relay.example.cjs",
    "plaid:report-duplicates": "node scripts/report-plaid-duplicate-accounts.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.intentflow.moneymanager",
    "productName": "IntentFlow",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "src/db/db-config.cjs",
      "src/db/database.config.js"
    ],
    "files": [
      ".next/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "src/shared/**/*",
      {
        "from": "src/db",
        "to": "src/db",
        "filter": [
          "**/*",
          "!data/app.db",
          "!data/**/*.db-wal",
          "!data/**/*.db-shm",
          "!data/**/*.db-journal"
        ]
      },
      "src/views/**/*",
      "src/services/**/*",
      "src/utils/**/*",
      "scripts/extension-native-host.cjs",
      "scripts/install-extension-native-host.cjs",
      "node_modules/**/*",
      "package.json",
      "next.config.js"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/db/data/empty-schema.sqlite",
        "to": "db/data/empty-schema.sqlite"
      },
      {
        "from": "src/db/data/production-seed.db",
        "to": "db/data/production-seed.db"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "protocols": [
        {
          "name": "IntentFlow Plaid OAuth",
          "schemes": [
            "intentflow"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.finance",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "protocols": [
        {
          "name": "IntentFlow Plaid OAuth",
          "schemes": [
            "intentflow"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "dotenv": "^17.3.1",
    "jose": "^5.10.0",
    "next": "^14.2.35",
    "plaid": "^41.4.0",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "cssnano": "^7.1.3",
    "electron": "^28.3.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.8",
    "postcss-discard-comments": "^7.0.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19"
  }
}